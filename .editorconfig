root = true

# All files
[*]
end_of_line = crlf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4

[*.cs]
# ==============================================================================
# HARD RULE: Prohibit 'var' everywhere - require explicit types
# ==============================================================================
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error

# Elevate Roslyn rule IDE0007 (use explicit type instead of 'var') to an error
dotnet_diagnostic.IDE0007.severity = error

# ==============================================================================
# CRITICAL UNITY SAFETY: Unity Lifetime vs. Reference Null Checks
# UnityEngine.Object overrides operator == and operator != to detect destroyed native objects.
# Pattern checks like 'is null' bypass operator == and can cause fake-null bugs.
# ==============================================================================
csharp_style_prefer_null_check_over_type_check = false:none
dotnet_diagnostic.IDE0041.severity = none

# ==============================================================================
# Modern C# Styles (Safe for Unity and .NET Framework 4.7.2 / C# 9.0+)
# ==============================================================================
csharp_style_inlined_variable_declaration = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion

csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:suggestion

# Pattern matching
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_extended_property_pattern = true:suggestion

# Loops: 'for' loop can be converted into 'foreach' loop (ReSharper / Rider)
resharper_for_can_be_converted_to_foreach_highlighting = warning

# ==============================================================================
# NAMESPACE & USING DIRECTIVE RULES
# IDE0130: Namespace does not match folder structure
# IDE0005: Using directive is unnecessary
# ==============================================================================
dotnet_diagnostic.IDE0130.severity = warning
dotnet_diagnostic.IDE0005.severity = warning


csharp_style_implicit_object_creation_when_type_is_apparent = false

dotnet_diagnostic.IDE0090.severity = none

dotnet_diagnostic.IDE0049.severity = none

# ==============================================================================
# NAMING CONVENTIONS:
# 1. Constants & static readonly fields use PascalCase
# 2. Private / internal instance fields use camelCase (no underscore prefix)
# ==============================================================================
dotnet_naming_rule.constants_must_be_pascal_case.symbols = constant_fields
dotnet_naming_rule.constants_must_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.constants_must_be_pascal_case.severity = suggestion

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_modifiers = const
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *

dotnet_naming_rule.static_readonly_fields_must_be_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_must_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.static_readonly_fields_must_be_pascal_case.severity = suggestion

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_modifiers = static, readonly
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *

dotnet_naming_rule.private_fields_must_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_must_be_camel_case.style = camel_case_style
dotnet_diagnostic.IDE1006.severity = suggestion

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_style.camel_case_style.capitalization = camel_case
dotnet_naming_style.camel_case_style.required_prefix = 

resharper_csharp_naming_rule_private_instance_fields = camel_case
resharper_csharp_naming_rule_private_static_fields = camel_case
resharper_csharp_naming_rule_constants = pascal_case